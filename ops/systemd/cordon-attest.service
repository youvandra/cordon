[Unit]
# The attestation endpoint: sells the conduct record over x402 at $0.001.
#
# This is the only unit here that holds a key. It can do exactly one thing
# with it — submit an EIP-3009 authorisation the payer already signed — and it
# refuses to start if the token cannot verify the domain it would publish.
Description=Cordon attest (conduct record over x402, on 127.0.0.1:8405)
Documentation=https://getcordon.xyz/docs/surfaces
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cordon/packages/attest
Environment=NODE_ENV=production
Environment=CORDON_CHAIN_ID=5042002
# CORDON_ATTEST_KEY lives here and nowhere else. Mode 0600, owned by ubuntu,
# never committed: .env.* is in .gitignore. The process exits 2 without it
# rather than starting and failing at the first settlement.
EnvironmentFile=/home/ubuntu/cordon/.env.attest
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/cordon/packages/attest
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The key is the whole asset here, so deny the two ways a compromised process
# would try to carry it out of the unit.
RestrictNamespaces=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cordon-attest

[Install]
WantedBy=multi-user.target
